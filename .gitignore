# History files
.Rhistory
.Rapp.history

# Session data
.RData
.RDataTmp

# User-specific files
.Ruserdata

# RStudio files
.Rproj.user/

# Exclude all large geospatial formats and archives
*.tif
*.tiff
*.gpkg
*.zip
*.tar.gz

# Exclude generated/raw data and temp files
data/processed/
data/raw/
temp/
outputs/

# Allow tracking .gitkeep files so directory structures remain intact
!.gitkeep

# NAIP grid reference (~36MB for the full sample) and its resumable cache
data/naip_reference.json
data/naip_reference*_cache.jsonl
run_logs/
